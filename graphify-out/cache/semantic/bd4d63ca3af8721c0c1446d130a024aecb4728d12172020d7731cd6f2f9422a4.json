{"nodes": [{"id": "frontend_performance_fixes_applied_doc", "label": "Low-Risk Performance Fixes Applied", "file_type": "document", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_performance_fixes_applied_promaps_valuekey_fix", "label": "ProMapsViewSimple Recreation Fix (stable ValueKey)", "file_type": "rationale", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ProMapsViewSimple.didUpdateWidget() already handles coordinate updates, so keying the widget by coordinates caused unnecessary full recreation (~150ms per GPS update); a constant key avoids recreation while updates still propagate via didUpdateWidget."}, {"id": "frontend_performance_fixes_applied_timer_to_animationcontroller_fix", "label": "Timer.periodic to AnimationController Migration (offer countdown)", "file_type": "rationale", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer.periodic at 50ms ticks caused 200 setState() calls per 10-second countdown (20fps rebuild rate); replacing with a vsync-driven AnimationController + AnimatedBuilder preserves exact timing while eliminating setState-driven rebuilds."}, {"id": "frontend_performance_fixes_applied_riverpod_select_optimization", "label": "Riverpod select() Optimization on newDriverProvider", "file_type": "rationale", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Watching the entire provider state caused rebuilds on any state change; select() on workState/availableOrders/isLoading/stats reduces rebuilds by ~60% by only reacting to relevant field changes."}, {"id": "frontend_performance_fixes_applied_frame_timing_monitor", "label": "FrameTimingMonitor (new performance instrumentation)", "file_type": "code", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_performance_fixes_applied_rebuild_tracker", "label": "RebuildTracker (new performance instrumentation)", "file_type": "code", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_performance_fixes_applied_client_home_screen", "label": "client_home_screen.dart", "file_type": "code", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_performance_fixes_applied_new_driver_home_screen", "label": "new_driver_home_screen.dart", "file_type": "code", "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "frontend_performance_fixes_applied_doc", "target": "frontend_performance_fixes_applied_promaps_valuekey_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "weight": 1.0}, {"source": "frontend_performance_fixes_applied_doc", "target": "frontend_performance_fixes_applied_timer_to_animationcontroller_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/PERFORMANCE_FIXES_APPLIED.md", "source_location": null, "weight": 1.0}, {"source": "frontend_performance_fixes_applied_doc", "target": "frontend_performance_fixes_applied_riverpod_select_optimization", "relation": "references", "confidence": "EXTRACTED", "confiden